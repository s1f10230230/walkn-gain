{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WalkingApp Analytics Event Dictionary (Simple MVP)",
  "type": "object",
  "properties": {
    "events": {
      "type": "object",
      "description": "Event name to definition mapping",
      "properties": {
        "app_open": {
          "type": "object",
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "source": { "type": "string", "enum": ["direct", "notification", "deeplink"] }
              },
              "required": ["source"]
            }
          }
        },
        "permission_health_changed": {
          "type": "object",
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "provider": { "type": "string", "enum": ["healthkit", "googlefit"] },
                "status": { "type": "string", "enum": ["granted", "denied", "limited"] }
              },
              "required": ["provider", "status"]
            }
          }
        },
        "steps_synced": {
          "type": "object",
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "steps": { "type": "integer", "minimum": 0 },
                "provider": { "type": "string", "enum": ["healthkit", "googlefit"] },
                "sync_ms": { "type": "integer", "minimum": 0 }
              },
              "required": ["date", "steps", "provider"]
            }
          }
        },
        "goal_set": {
          "type": "object",
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "target_steps": { "type": "integer", "minimum": 1000 }
              },
              "required": ["target_steps"]
            }
          }
        },
        "goal_achieved": {
          "type": "object",
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "steps": { "type": "integer", "minimum": 0 }
              },
              "required": ["date", "steps"]
            }
          }
        },
        "streak_updated": {
          "type": "object",
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "current": { "type": "integer", "minimum": 0 },
                "longest": { "type": "integer", "minimum": 0 },
                "change_type": { "type": "string", "enum": ["keep", "break", "new_best"] }
              },
              "required": ["date", "current", "longest", "change_type"]
            }
          }
        },
        
        "share_card_generated": {
          "type": "object",
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "template": { "type": "string", "enum": ["sporty", "calm"] },
                "aspect": { "type": "string", "enum": ["9:16", "1:1"] },
                "saved": { "type": "boolean" }
              },
              "required": ["template", "aspect", "saved"]
            }
          }
        },
        "share_shared": {
          "type": "object",
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "destination": { "type": "string", "enum": ["instagram", "x", "line", "other"] },
                "aspect": { "type": "string", "enum": ["9:16", "1:1"] }
              }
            }
          }
        },
        "reminder_sent": {
          "type": "object",
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "enum": ["streak", "goal"] }
              },
              "required": ["type"]
            }
          }
        },
        "notification_opened": {
          "type": "object",
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "enum": ["streak", "weekly_summary", "goal"] }
              },
              "required": ["type"]
            }
          }
        },
        "ab_variant_assigned": {
          "type": "object",
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "experiment": { "type": "string" },
                "variant": { "type": "string" }
              },
              "required": ["experiment", "variant"]
            }
          }
        },
        "history_viewed": {
          "type": "object",
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "range": { "type": "string", "enum": ["7d", "30d"] }
              },
              "required": ["range"]
            }
          }
        },
        "settings_changed": {
          "type": "object",
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "field": { "type": "string", "enum": ["daily_goal", "reminder_time", "theme"] }
              },
              "required": ["field"]
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["events"],
  "additionalProperties": false
}
