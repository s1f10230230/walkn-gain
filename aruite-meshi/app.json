{
  "expo": {
    "owner": "s.shion",
    "name": "Walk'n Gain",
    "slug": "aruite-meshi",
    "version": "1.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",

    "plugins": [
      [
        "@kingstinct/react-native-healthkit",
        {
          "background-delivery": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "otherLinkerFlags": ["-ObjC"]
          }
        }
      ]
    ],

    "ios": {
      "bundleIdentifier": "com.walkngain.app",
      "supportsTablet": false,
      "requireFullScreen": true,
      "buildNumber": "55",

      "infoPlist": {
        "NSHealthShareUsageDescription": "歩数データを読み取り、アプリ内で表示します。",
        "NSHealthUpdateUsageDescription": "歩数データを記録します。",
        "NSMotionUsageDescription": "歩数を計測するために、モーションセンサーにアクセスします。",
        "NSCalendarsUsageDescription": "履歴にカレンダーの予定を表示します。",
        "NSCalendarsFullAccessUsageDescription": "履歴にカレンダーの予定を表示します。",
        "NSPhotoLibraryAddUsageDescription": "画像を写真ライブラリに保存します。",
        "NSPhotoLibraryUsageDescription": "画像を保存するために写真ライブラリへアクセスします。",
        "UIBackgroundModes": ["fetch"],
        "ITSAppUsesNonExemptEncryption": false
      },

      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.background-delivery": true
      }
    },

    "locales": {
      "en": "./locales/en.json",
      "ja": "./locales/ja.json",
      "zh-Hans": "./locales/zh-Hans.json"
    },

    "extra": {
      "eas": {
        "projectId": "7c14de9c-dcd2-4217-980e-eeb9eac22a7b"
      }
    }
  }
}
