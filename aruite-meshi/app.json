{
  "expo": {
    "owner": "s.shion",
    "name": "Walk'n Gain",
    "slug": "aruite-meshi",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF",
      "dark": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#121212"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      [
        "react-native-health",
        {
          "healthSharePermission": "歩数データを読み取り、アプリ内で表示します。",
          "healthUpdatePermission": "アプリ内で歩数データを書き込みます（任意）",
          "isClinicalDataEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "otherLinkerFlags": ["-ObjC"]
          }
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.walkngain.app",
      "supportsTablet": true,
      "requireFullScreen": false,
      "icon": "./assets/icon.png",
      "splash": {
        "backgroundColor": "#FFFFFF",
        "dark": {
          "backgroundColor": "#121212"
        }
      },
      "infoPlist": {
        "NSHealthShareUsageDescription": "歩数データを読み取り、アプリ内で表示します。",
        "NSMotionUsageDescription": "歩数を計測するために、モーションセンサーにアクセスします。",
        "NSCalendarsUsageDescription": "履歴にカレンダーの予定を表示します。",
        "NSCalendarsFullAccessUsageDescription": "履歴にカレンダーの予定を表示します。",
        "UIBackgroundModes": ["fetch", "remote-notification"],
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": [],
        "com.apple.developer.healthkit.background-delivery": true,
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },

    "extra": {
      "eas": {
        "projectId": "7c14de9c-dcd2-4217-980e-eeb9eac22a7b"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/7c14de9c-dcd2-4217-980e-eeb9eac22a7b"
    },
    "android": {
      "splash": {
        "backgroundColor": "#FFFFFF",
        "dark": {
          "backgroundColor": "#121212"
        }
      }
    }
  }
}
